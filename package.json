{
  "name": "@jidekaixin2dian/dsh-factmesh",
  "version": "0.1.0",
  "description": "Reconcile numbers in PowerPoint reports with Excel evidence and reuse confirmed links next month.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/factmesh.test.js",
    "test:host": "node scripts/test-host.mjs",
    "test:update": "node --experimental-transform-types scripts/test-update.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidekaixin2dian/dsh-factmesh.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "excel",
    "powerpoint",
    "reconciliation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@zip.js/zip.js": "2.8.14",
    "decimal.js": "10.6.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "saxes": "6.0.0"
  }
}
